{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-city.local/contracts/comic-preproduction-review.schema.json",
  "title": "Предгенерационное решение по выпуску OpenCity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "issue",
    "decision",
    "preproduction_sha256",
    "reviewer_role",
    "decided_at",
    "source"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "issue": {"type": "string", "pattern": "^issue-[0-9]{3}$"},
    "decision": {"enum": ["approved", "changes_requested"]},
    "preproduction_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer_role": {"const": "showrunner"},
    "decided_at": {"type": "string", "format": "date-time"},
    "source": {"enum": ["telegram_editorial_chat", "codex_editorial_chat"]},
    "comment": {"type": ["string", "null"]}
  }
}
